# Local .terraform directories
**/.terraform/*

# Terraform lock file
.terraform.lock.hcl

# State files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Plan output files
*.tfplan

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# CLI configuration / override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json
